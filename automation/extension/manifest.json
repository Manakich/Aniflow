{
  "manifest_version": 3,
  "name": "Manga Recap — Secret Voicer Connector",
  "version": "0.2.0",
  "description": "Соединяет локальный Python-проект с открытой вкладкой Secret Voicer.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://secretvoicer.com/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Manga Recap — Secret Voicer",
    "default_popup": "popup.html"
  }
}
