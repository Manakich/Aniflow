# ─────────────────────────────────────────────────────────────────
#  AniFlow Environment Configuration
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your API keys as needed.
# Only required for the cloud LLM or thumbnail image generation.

# ─── Flask (optional — only matters if exposing to a network) ────
# FLASK_SECRET_KEY=change-me-to-a-random-string

# ─── Cloud LLM (optional — use Ollama locally instead) ───────────
# GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_API_KEY=your_claude_api_key_here

# ─── 9router (Alternative to Ollama) ─────────────────────────────
# USE_NINE_ROUTER=1
# NINE_ROUTER_HOST=http://127.0.0.1:20128
# NINE_ROUTER_API_KEY=your_9router_api_key_here
# VISION_MODEL=Free-Tier
# WRITER_MODEL=Free-Tier
# TEXT_WRITER_MODEL=Free-Tier

# ─── MyAnimeList Character Import (optional) ─────────────────────
# MAL_CLIENT_ID=your_mal_client_id_here

# ─── Full Recap Studio thumbnails (optional) ─────────────────────
# Used only for the three reference-guided YouTube thumbnail images.
OPENAI_API_KEY=your_openai_api_key_here
# Optional: gpt-image-2.5-sunburst or gpt-image-2.5-flare
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Optional: compatible API base URL (do not change unless your provider is compatible).
# OPENAI_API_BASE_URL=https://api.openai.com/v1
